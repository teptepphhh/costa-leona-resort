# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# On AWS these come from SSM Parameter Store, not from a file.
APP_TITLE=Costa Leona Resort
CUSTOM_FOOTER=Costa Leona Resort - fictional demo. Leona is an AI assistant: please confirm important details with the front desk.
HELP_AND_FAQ_URL=https://localhost
DOMAIN_CLIENT=http://localhost:3081
DOMAIN_SERVER=http://localhost:3081
PORT=3081
ENDPOINTS=custom
SEARCH=false
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_EMAIL_LOGIN=true
SCHEDULES_SINGLE_PROCESS=true
CREDS_KEY=<64 hex chars>
CREDS_IV=<32 hex chars>
JWT_SECRET=<64 hex chars>
JWT_REFRESH_SECRET=<64 hex chars>
LEONA_GATEWAY_TOKEN=<random string>
GEMINI_API_KEY=<your Google AI Studio key - local only>
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
APP_VERSION=1.0.0
